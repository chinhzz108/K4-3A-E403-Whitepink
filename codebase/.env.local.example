# ScriptScout API keys — only placeholders; never put real keys in this sample.

# 9Router local gateway — primary
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=kr/auto

# Groq fallback
GROQ_API_KEY=

# Google Gemini final fallback
GOOGLE_API_KEY=

# Optional web search; without it, search falls back to other engines.
SERPER_API_KEY=
